# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# CASHFREE PAYMENT GATEWAY (SERVER-SIDE ONLY - NEVER EXPOSE TO BROWSER)
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=production
# Optional currency override (defaults to USD):
CASHFREE_CURRENCY=USD

# PADDLE BILLING INTEGRATION (PADDLE.JS)
# Client-side safe token (e.g. live_... or test_...). Never expose API secret keys in frontend.
VITE_PADDLE_CLIENT_TOKEN=
# Existing Paddle Price ID for BizPilot Pro $9.99/month recurring price (e.g. pri_...)
VITE_PADDLE_PRICE_ID=
# Paddle Environment: 'production' or 'sandbox'
VITE_PADDLE_ENV=production

